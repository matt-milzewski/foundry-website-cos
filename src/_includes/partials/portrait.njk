{% macro portrait(name, src, size) %}{% if src %}<img class="portrait{% if size %} portrait--{{ size }}{% endif %}" src="{{ src }}" alt="Portrait of {{ name }}" width="120" height="120" loading="lazy" decoding="async">{% else %}<span class="portrait portrait--mono{% if size %} portrait--{{ size }}{% endif %}" role="img" aria-label="{{ name }}">{{ name | initials }}</span>{% endif %}{% endmacro %}
